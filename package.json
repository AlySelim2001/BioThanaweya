{
  "name": "biothanaweya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server.ts",
    "dev:client": "vite --host 0.0.0.0 --port 3000",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "bash scripts/clean-slate.sh",
    "android:sync": "bash scripts/sync-android-assets.sh",
    "build:android": "npm run lint && npm test && bash scripts/build-android.sh",
    "audit": "npm audit --audit-level=high && tsc --noEmit",
    "audit:full": "bash scripts/audit-and-validate.sh",
    "verify": "bash scripts/verify-local.sh",
    "release": "bash scripts/release.sh",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "express": "^4.21.2",
    "framer-motion": "^14.10.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.6"
  }
}
